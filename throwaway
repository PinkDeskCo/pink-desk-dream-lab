
@media (max-width: 1050px) {

    .dream-note-cta__inner {
        min-height: 610px;
    }


    .dream-note-cta__paper {
        width: 88%;
    }


    .dream-note-cta__margin-note {
        display: none;
    }

}
@media (max-width: 1000px) and (min-width: 851px) {

    .from-the-lab {
        padding:
            18px
            10px
            40px;

        overflow-x: auto;
    }

    .from-the-lab__inner {
        min-width: 980px;
        width: 980px;
    }

    .from-the-lab__canvas {
        min-height: 0;
        height: 490px;
    }

}
@media (max-width: 980px) {

    .dream-note-cta {
        padding:
            60px
            32px
            65px;
    }

    .dream-note-cta__inner {
        min-height: 560px;
    }

    .dream-note-cta__paper {
        width: 100%;
        max-width: 720px;

        padding:
            64px
            52px
            56px;
    }

    .dream-note-cta__content {
        max-width: 600px;
    }

    .dream-note-cta__eyebrow {
        font-size: 0.76rem;
        letter-spacing: 0.26em;
    }

    .dream-note-cta__divider {
        width: min(460px, 86%);
        margin:
            14px
            auto
            26px;
    }

    .dream-note-cta__title {
        font-size: 2.8rem;
        line-height: 1.04;
    }

    .dream-note-cta__title span {
        margin-top: 8px;
    }

    .dream-note-cta__copy {
        max-width: 540px;
        margin-top: 26px;

        font-size: 1.05rem;
        line-height: 1.55;
    }

    .dream-note-cta__button {
        width: min(430px, 90%);

        margin-top: 28px;
        padding:
            16px
            26px;

        font-size: 1.08rem;
    }

    .dream-note-cta__margin-note {
        display: none;
    }

}
@media (max-width: 700px) {

    .dream-note-cta {
        padding:
            42px 16px
            46px;
    }


    .dream-note-cta__inner {
        min-height: 0;
    }


    .dream-note-cta__paper {
        width: 100%;

        padding:
            48px 24px
            42px;
    }


    .dream-note-cta__title {
        font-size:
            clamp(
                2rem,
                9vw,
                2.8rem
            );
    }


    .dream-note-cta__copy {
        font-size: 1rem;
    }


    .dream-note-cta__button {
        width: 100%;

        gap: 14px;

        font-size: 1.05rem;
    }


    .dream-note-cta__heart-clip {
        top: 8px;
        right: 3%;
    }


    .dream-note-cta__coffee-ring {
        right: -62px;
        bottom: -48px;
    }

}
@media (max-width: 850px) {

    .from-the-lab {
        width: 100%;

        padding:
            38px
            20px
            60px;

        overflow: hidden;
    }

    .from-the-lab__inner {
        width: 100%;
        min-width: 0;

        margin: 0 auto;
    }

    .from-the-lab__canvas {
        display: flex;
        flex-direction: column;
        align-items: center;

        width: 100%;
        height: auto;
        min-height: 0;

        aspect-ratio: auto;
    }

    .from-the-lab__header {
        position: relative;

        top: auto;
        left: auto;

        width: 100%;

        margin: 0 auto 20px;

        text-align: center;
    }

    .from-the-lab__title {
        font-size: 3.7rem;
        line-height: 0.88;
    }

    .from-the-lab__tagline {
        margin-top: 14px;

        font-size: 0.68rem;
        letter-spacing: 0.16em;
        line-height: 1.4;
    }

    .from-the-lab__header::after {
        bottom: -12px;
    }

    .from-the-lab__magic {
        display: none;
    }

    .from-the-lab__feature {
        position: relative;

        top: auto;
        right: auto;
        left: auto;

        display: flex;
        flex-direction: column;

        width: 100%;
        height: auto;

        gap: 0;
    }

    .from-the-lab__character {
        order: 1;

        width: 100%;
        height: auto;

        margin: 10px auto 0;

        align-items: center;
        justify-content: center;
    }

    .from-the-lab__character img {
        width: min(92%, 390px);
        max-width: none;
        max-height: none;

        margin: 0 auto;

        object-fit: contain;
    }

    /* -------------------------------
       FEATURED PROJECT
    ------------------------------- */

    .lab-project__story {
        order: 2;

        width: 100%;
        max-width: 390px;

        margin: 8px auto 0;

        padding:
            42px
            32px
            38px;

        transform: rotate(-0.5deg);
    }

    .lab-project__number {
        margin-bottom: 12px;

        font-size: 0.7rem;
    }

    .lab-project__title {
        margin-bottom: 14px;

        font-size: 2rem;
        line-height: 1.05;
    }

    .lab-project__description {
        margin-bottom: 16px;

        font-size: 0.95rem;
        line-height: 1.5;
    }

    .lab-project__notes-button {
        width: min(280px, 88%);

        margin:
            18px
            auto
            8px;
    }

    .lab-project__scribble {
        margin-top: 8px;

        font-size: 1.7rem;
        line-height: 1;
    }

    .lab-feature__board-wrap {
        order: 3;

        width: 100%;
        height: auto;

        margin: 40px auto 0;

        overflow: hidden;
    }

    .lab-feature__board {
        width: 100%;
        max-width: 100%;
        max-height: none;

        object-fit: contain;
    }

    /* -------------------------------
       MORE FROM THE LAB
    ------------------------------- */

    .from-the-lab__more-heading {
        position: relative;

        top: auto;
        right: auto;
        bottom: auto;
        left: auto;

        width: 100%;

        margin: 38px auto 4px;

        text-align: center;
    }

    .from-the-lab__more-heading p {
        margin: 0;

        font-size: 2.2rem;
        line-height: 1;

        transform: rotate(-2deg);
    }

    .from-the-lab__more-heading span {
        display: inline;

        margin-left: 5px;
    }

    .from-the-lab__more-arrow {
        display: none;
    }

    /* -------------------------------
       PROJECT POLAROIDS
    ------------------------------- */

    .lab-projects {
        position: relative;

        z-index: 20;

        right: auto;
        bottom: auto;

        display: flex;
        align-items: flex-start;
        justify-content: flex-start;

        gap: 18px;

        width: 100%;

        margin: 4px 0 0;
        padding: 12px 0 28px;

        overflow-x: auto;
        overflow-y: visible;

        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;

        scrollbar-width: none;
    }

    .lab-projects::-webkit-scrollbar {
        display: none;
    }

    .lab-projects__card {
        flex: 0 0 78%;

        width: 78%;
        max-width: 270px;

        padding:
            10px
            10px
            16px;

        scroll-snap-align: center;
    }

    .lab-projects__nav:disabled {
        opacity: 0.28;
        cursor: default;
    }

    .lab-projects__swipe-cue {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        width: 100%;
        margin: 8px 0 0;

        color: rgba(31, 58, 95, 0.68);

        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .lab-projects__swipe-cue span {
        font-size: 1rem;
        line-height: 1;
    }
}
@media (max-width: 640px) {

    .dream-note-cta {
        padding:
            55px 18px;
    }

    .dream-note-cta__paper {
        width: 100%;

        padding:
            55px 25px
            48px;
    }

    .dream-note-cta__eyebrow {
        letter-spacing: 0.2em;
    }

    .dream-note-cta__copy {
        font-size: 1rem;
    }

    .dream-note-cta__button {
        min-width: 0;
        width: 100%;

        gap: 14px;
    }

    .dream-note-cta__heart-clip {
        right: 3%;
    }

    .dream-note-cta__coffee-ring {
        right: -55px;
        bottom: -45px;
    }

}